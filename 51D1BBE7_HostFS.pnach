gametitle=Midnight Club 3: DUB Edition (October 24th 2004 Alpha)
comment=HostFS Unpacked by Thiekus

[HostFS Unpacked]
description=Enable HostFS with unpacked data for MC3 24 October 2004 build
author=Thiekus

// Put coreBootedFromDisc from 1 to 0
patch=0,EE,003689f4,word,24020000

// Don't need host0 prefix as T:\mc3\assets
patch=0,EE,005ee442,byte,00 // No prefix so I didn't need patch more funcs :)
//patch=0,EE,005ee442,byte,41 // a
//patch=0,EE,005ee443,byte,53 // s
//patch=0,EE,005ee444,byte,53 // s
//patch=0,EE,005ee445,byte,45 // e
//patch=0,EE,005ee446,byte,54 // t
//patch=0,EE,005ee447,byte,53 // s
//patch=0,EE,005ee448,byte,2F // /
//patch=0,EE,005ee449,byte,00 // \0

// Load IOP modules from host0:
// Remove ;1 suffix on IOPRP280.IMG;1
patch=0,EE,005f6440,byte,00

// c:/usr/local/sce/iop/modules/ to SYSTEM/
patch=0,EE,005f6487,byte,53 // S
patch=0,EE,005f6488,byte,59 // Y
patch=0,EE,005f6489,byte,53 // S
patch=0,EE,005f648a,byte,54 // T
patch=0,EE,005f648b,byte,45 // E
patch=0,EE,005f648c,byte,4D // M
patch=0,EE,005f648d,byte,2F // /
patch=0,EE,005f6487,byte,00 // \0

// IOP cdrom0:\ to host0:
patch=0,EE,0060dd50,byte,68 // h
patch=0,EE,0060dd51,byte,6F // o
patch=0,EE,0060dd52,byte,73 // s
patch=0,EE,0060dd53,byte,74 // t
patch=0,EE,0060dd54,byte,30 // 0
patch=0,EE,0060dd55,byte,3A // :
patch=0,EE,0060dd56,byte,00 // \0

// .IRX; to just .irx
patch=0,EE,005f6480,byte,2E // .
patch=0,EE,005f6481,byte,69 // i
patch=0,EE,005f6482,byte,72 // r
patch=0,EE,005f6483,byte,78 // x
patch=0,EE,005f6484,byte,00 // \0

// Disable push folder on mcLayerCity::Load
patch=0,EE,001a8150,word,00000000
patch=0,EE,001a816c,word,00000000

// Also disable pop folder
patch=0,EE,001A8334,word,00000000
patch=0,EE,001A8348,word,00000000

[Unpacked Streams]
description=WARNING: DON'T ENABLE THIS PATCHES YET UNLESS YOU KNOW WHAT YOU DOING!
